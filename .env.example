# Copy to .env to override docker-compose defaults. Never commit .env.

# --- Database (docker compose defaults shown) ---
DB_NAME=clinic
DB_USER=clinic
DB_PASSWORD=clinic

# --- Production only (set via Cloud Run env vars / Secret Manager) ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_ALLOWED_HOSTS=<service>.run.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<service>.run.app
# DB_HOST=/cloudsql/<project>:<region>:<instance>
# BOOKING_MIN_LEAD_MINUTES=60
